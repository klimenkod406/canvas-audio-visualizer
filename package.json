{
  "name": "canvas-audio-visualizer",
  "version": "0.1.0",
  "description": "Canvas 2D audio visualiser core: FFT band splitting, bass-spike beat detection with interval tracking, palette interpolation and ring geometry.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "audio",
    "visualizer",
    "visualisation",
    "canvas",
    "fft",
    "beat-detection",
    "web-audio"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klimenkod406/canvas-audio-visualizer.git"
  },
  "peerDependencies": {
    "typescript": ">=5.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}